{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://officeclaw.local/schemas/excel_complex_oracle_schema.v1.json",
  "title": "OfficeClaw Excel Complex Scenario Pack v1",
  "description": "복잡 업무형 Excel 시나리오 검증용 스키마. 오라클을 대화/실행/결과로 분리해 정의한다.",
  "type": "object",
  "required": [
    "schema_version",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "excel_complex_scenarios.v1"
    },
    "version": {
      "type": "string"
    },
    "defaults": {
      "type": "object",
      "properties": {
        "approve": {
          "type": "boolean"
        },
        "seed_profile": {
          "type": "string"
        },
        "sheet_name": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "turns",
          "oracle"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^complex-[0-9]{3}.*$"
          },
          "title": {
            "type": "string",
            "minLength": 2
          },
          "category": {
            "type": "string"
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "hard",
              "very-hard"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "major",
              "critical"
            ]
          },
          "seed_profile": {
            "type": "string"
          },
          "sheet_name": {
            "type": "string"
          },
          "turns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "message"
              ],
              "properties": {
                "message": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            }
          },
          "oracle": {
            "type": "object",
            "required": [
              "conversation",
              "execution",
              "result"
            ],
            "properties": {
              "conversation": {
                "type": "object",
                "properties": {
                  "turn_expectations": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "turn_index"
                      ],
                      "properties": {
                        "turn_index": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "status_code": {
                          "type": "integer"
                        },
                        "status_in": {
                          "type": "array",
                          "items": {
                            "type": "integer"
                          }
                        },
                        "action": {
                          "type": "string"
                        },
                        "action_in": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "ask_follow_up": {
                          "type": "boolean"
                        },
                        "result_numeric_gte": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "number"
                          }
                        },
                        "result_equals": {
                          "type": "object",
                          "additionalProperties": true
                        }
                      },
                      "additionalProperties": true
                    }
                  }
                },
                "additionalProperties": true
              },
              "execution": {
                "type": "object",
                "properties": {
                  "must_include_actions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "forbid_actions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": true
              },
              "result": {
                "type": "object",
                "properties": {
                  "assertions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "type"
                      ],
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "sheet_exists",
                            "cell_equals",
                            "cell_formula_startswith",
                            "range_non_empty_at_least",
                            "sheet_protected",
                            "data_validation_exists",
                            "chart_count_at_least",
                            "cell_has_border",
                            "cell_has_fill"
                          ]
                        },
                        "sheet": {
                          "type": "string"
                        },
                        "cell": {
                          "type": "string"
                        },
                        "range": {
                          "type": "string"
                        },
                        "expected": {},
                        "prefix": {
                          "type": "string"
                        },
                        "min_count": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "target_range": {
                          "type": "string"
                        },
                        "min_charts": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "additionalProperties": true
                    }
                  }
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
