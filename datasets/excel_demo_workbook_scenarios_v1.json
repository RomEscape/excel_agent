    {
      "id": "demo-011-region-chart",
      "title": "지역별 집계 후 막대차트",
      "category": "pipeline",
      "difficulty": "very-hard",
      "severity": "major",
      "turns": [
        {
          "message": "지역별 매출 합계를 Region_Chart 시트에 집계해줘"
        },
        {
          "message": "그 결과로 막대 그래프도 만들어줘"
        }
