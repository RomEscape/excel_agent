{
  "schema_version": "excel_complex_scenarios.v1",
  "title": "AI_Excel_Automation_Demo 워크북 실무 명령 검증팩",
  "note": "영문 머리글 + 한국어 명령 조합. 가이드 문서의 자연어 명령 12종을 그대로 옮겼다.",
  "defaults": {
    "sheet_name": "Sales_Data",
    "seed_template": "복잡한 엑셀 작업을 위한 자료/AI_Excel_Automation_Demo.xlsx",
    "approve": true
  },
  "scenarios": [
    {
      "id": "demo-001-sort-by-date",
      "title": "매출 데이터를 날짜 오름차순 정렬",
      "category": "sort",
      "difficulty": "hard",
      "severity": "critical",
      "turns": [
        {
          "message": "매출 데이터를 주문일자 오름차순으로 정렬해줘"
        }
      ],
      "oracle": {
        "conversation": {
          "turn_expectations": [
            {
              "turn_index": 0,
              "status_code": 200,
              "action": "excel_live.sort_range"
            }
          ]
        },
        "execution": {
          "must_include_actions": [
            "excel_live.sort_range"
          ],
          "forbid_actions": [
            "excel_live.clear_range"
          ]
        },
        "result": {
          "assertions": [
            {
              "type": "column_sorted",
              "sheet": "Sales_Data",
              "range": "B2:B181"
            }
          ]
        }
      }
    },
    {
      "id": "demo-002-highlight-low-sales",
      "title": "100만 원 미만 매출 빨간색 표시",
      "category": "format",
      "difficulty": "hard",
      "severity": "critical",
      "turns": [
        {
          "message": "매출이 100만 원 미만인 건은 빨간색으로 표시해줘"
        }
      ],
      "oracle": {
        "conversation": {
          "turn_expectations": [
            {
              "turn_index": 0,
              "status_code": 200,
              "action": "excel_live.highlight_by_condition"
            }
          ]
        },
        "execution": {
          "must_include_actions": [
            "excel_live.highlight_by_condition"
          ]
        },
        "result": {
          "assertions": [
            {
              "type": "filled_cell_count_equals",
              "sheet": "Sales_Data",
              "range": "L2:L181",
              "expected": 81
            }
          ]
        }
      }
    },
    {
      "id": "demo-003-profit-margin-formula",
      "title": "이익률 열 수식 채우기",
      "category": "formula",
      "difficulty": "hard",
      "severity": "critical",
      "turns": [
        {
          "message": "이익률 열에 매출이익 나누기 매출 수식을 넣어줘"
        }
      ],
      "oracle": {
        "conversation": {
          "turn_expectations": [
            {
              "turn_index": 0,
              "status_code": 200,
              "action_in": [
                "excel_live.set_formula",
                "excel_live.formula",
                "excel_live.verify_formula_result"
              ]
            }
          ]
        },
        "execution": {
          "must_include_actions": [
            "excel_live.set_formula"
          ]
        },
        "result": {
          "assertions": [
            {
              "type": "cell_formula_startswith",
              "sheet": "Sales_Data",
              "cell": "O2",
              "prefix": "="
            },
            {
              "type": "range_non_empty_at_least",
              "sheet": "Sales_Data",
              "range": "O2:O181",
              "min_count": 180
            }
          ]
        }
      }
    },
    {
      "id": "demo-004-regional-report",
      "title": "지역별 매출·이익 집계표",
      "category": "pivot",
      "difficulty": "very-hard",
      "severity": "critical",
      "turns": [
        {
          "message": "지역별 매출 합계를 집계해서 Regional_Report 시트에 만들어줘"
        }
      ],
      "oracle": {
        "conversation": {
          "turn_expectations": [
            {
              "turn_index": 0,
              "status_code": 200
            }
          ]
        },
        "execution": {
          "must_include_actions": [
            "excel_live.pivot_table"
          ]
        },
        "result": {
          "assertions": [
            {
              "type": "sheet_exists",
              "sheet": "Regional_Report"
            },
            {
              "type": "range_non_empty_at_least",
              "sheet": "Regional_Report",
              "range": "A1:B3",
              "min_count": 4
            },
            {
              "type": "range_sum_equals",
              "sheet": "Regional_Report",
              "range": "B2:B20",
              "expected": 733223910,
              "tolerance": 1
            }
          ]
        }
      }
    },
    {
      "id": "demo-005-channel-category-pivot",
      "title": "채널별·카테고리별 피벗",
      "category": "pivot",
      "difficulty": "very-hard",
      "severity": "critical",
      "turns": [
        {
          "message": "채널을 행으로 카테고리를 열로 해서 매출 합계 피벗을 Pivot_Report 시트에 만들어줘"
        }
      ],
      "oracle": {
        "conversation": {
          "turn_expectations": [
            {
              "turn_index": 0,
              "status_code": 200
            }
          ]
        },
        "execution": {
          "must_include_actions": [
            "excel_live.pivot_table"
          ]
        },
        "result": {
          "assertions": [
            {
              "type": "sheet_exists",
              "sheet": "Pivot_Report"
            },
            {
              "type": "range_non_empty_at_least",
              "sheet": "Pivot_Report",
              "range": "A1:C3",
              "min_count": 4
            }
          ]
        }
      }
    },
    {
      "id": "demo-006-salesperson-ranking",
      "title": "영업담당자별 실적 집계",
      "category": "pivot",
      "difficulty": "very-hard",
      "severity": "major",
      "turns": [
        {
          "message": "영업담당자별 매출 합계를 구해서 Sales_Rank 시트에 정리해줘"
        }
      ],
      "oracle": {
        "conversation": {
          "turn_expectations": [
            {
              "turn_index": 0,
              "status_code": 200
            }
          ]
        },
        "execution": {
          "must_include_actions": [
            "excel_live.pivot_table"
          ]
        },
        "result": {
          "assertions": [
            {
              "type": "sheet_exists",
              "sheet": "Sales_Rank"
            },
            {
              "type": "range_sum_equals",
              "sheet": "Sales_Rank",
              "range": "B2:B40",
              "expected": 733223910,
              "tolerance": 1
            },
            {
              "type": "row_count_between",
              "sheet": "Sales_Rank",
              "range": "A2:A40",
              "min_rows": 3,
              "max_rows": 20
            }
          ]
        }
      }
    },
    {
      "id": "demo-007-duplicate-order-id",
      "title": "중복 주문번호 찾기",
      "category": "quality",
      "difficulty": "very-hard",
      "severity": "critical",
      "turns": [
        {
          "message": "주문번호가 중복된 건이 있는지 찾아서 알려줘"
        }
      ],
      "oracle": {
        "conversation": {
          "turn_expectations": [
            {
              "turn_index": 0,
              "status_code": 200
            }
          ]
        },
        "execution": {
          "must_include_actions": [
            "excel_live.find_duplicates"
          ],
          "forbid_actions": [
            "excel_live.dedupe_rows",
            "excel_live.clear_range"
          ]
        },
        "result": {
          "assertions": [
            {
              "type": "row_count_between",
              "sheet": "Sales_Data",
              "range": "A1:A181",
              "min_rows": 181,
              "max_rows": 181
            },
            {
              "type": "range_sum_equals",
              "sheet": "Sales_Data",
              "range": "I2:I181",
              "expected": 773,
              "tolerance": 0
            }
          ]
        }
      }
    },
    {
