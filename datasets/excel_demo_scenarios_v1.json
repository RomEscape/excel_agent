{
  "schema_version": "excel_complex_scenarios.v1",
  "note": "시연용 멀티턴 팩. 한 통합문서·한 세션에서 턴이 이어지며 결과물이 쌓인다. 배터리(command_battery.py)는 케이스마다 새 워크북을 쓰기 때문에 '이어서 쌓이는' 동작은 검증하지 못한다 — 그 빈칸을 메우는 팩이다.",
  "defaults": {
    "sheet_name": "매출",
    "seed_profile": "sales_core",
    "approve": true
  },
  "scenarios": [
    {
      "id": "demo-monthly-report",
      "title": "월간 매출 보고서 — 정리 → 정렬 → 강조 → 집계 → 차트",
      "category": "demo",
      "difficulty": "medium",
      "severity": "major",
      "sheet_name": "매출",
      "turns": [
        { "message": "코드 열 기준으로 중복 제거해줘" },
        { "message": "금액 열 기준 내림차순으로 정렬해줘" },
        { "message": "금액이 1000 미만인 건은 노란색으로 표시해줘" },
        { "message": "A1:H1에 테두리 넣어줘" },
        { "message": "카테고리별 금액 합계를 집계해서 카테고리요약 시트에 만들어줘" },
        { "message": "저장해줘" }
      ],
      "oracle": {
        "execution": {
          "must_include_actions": [
            "excel_live.dedupe_rows",
            "excel_live.sort_range",
            "excel_live.highlight_by_condition",
            "excel_live.apply_border"
          ]
        },
        "result": {
          "assertions": [
            {
              "type": "row_count_between",
              "sheet": "매출",
              "range": "H2:H30",
              "min_rows": 7,
              "max_rows": 7
            },
            {
              "type": "column_sorted",
              "sheet": "매출",
              "range": "E2:E8",
              "descending": true
            },
            { "type": "cell_has_border", "sheet": "매출", "cell": "A1" },
            { "type": "sheet_exists", "sheet": "카테고리요약" }
          ]
        }
      }
    },
    {
      "id": "demo-multiturn-slots",
      "title": "되묻기 멀티턴 — 부족한 정보를 대화로 채워 새 시트에 표를 만든다",
      "note": "표는 반드시 빈 시트에 만든다. 데이터가 있는 시트에 '3행 3열 표'를 만들면 그 블록이 기존 행을 덮어쓰고, 이후 정렬이 빈 행을 밀어내면서 원본이 사라진다(2026-08-11 실측).",
      "category": "demo",
      "difficulty": "easy",
      "severity": "major",
      "sheet_name": "정산",
      "turns": [
        { "message": "정산 시트 만들어줘" },
        { "message": "표 만들어줘" },
        { "message": "3행 3열, 머리글은 이름, 점수, 등급" }
      ],
      "oracle": {
        "conversation": {
          "turn_expectations": [
            { "turn_index": 1, "ask_follow_up": true },
            { "turn_index": 2, "ask_follow_up": false }
          ]
        },
        "result": {
          "assertions": [
            { "type": "sheet_exists", "sheet": "정산" },
            { "type": "header_equals", "sheet": "정산", "cell": "A1", "expected": "이름" },
            { "type": "header_equals", "sheet": "정산", "cell": "B1", "expected": "점수" },
            { "type": "header_equals", "sheet": "정산", "cell": "C1", "expected": "등급" },
            { "type": "cell_equals", "sheet": "평가", "cell": "A2", "expected": "민수" },
            { "type": "cell_equals", "sheet": "평가", "cell": "C1", "expected": "결과" }
          ]
        }
      }
    },
    {
      "id": "regress-slot-keeps-named-sheet",
      "title": "되묻기를 거쳐도 문장에서 지목한 시트를 잃지 않는다",
      "note": "회귀 방지. 활성 시트를 데이터가 든 '평가'로 두고, 문장으로만 '정산'을 지목한다. 예전에는 되묻기 다음 턴에서 정산을 잃고 평가 1~3행을 표 블록으로 덮어써 민수·지은 데이터가 경고 없이 사라졌다(2026-08-11, 3회 3회 재현).",
      "category": "regression",
      "difficulty": "medium",
      "severity": "critical",
      "sheet_name": "평가",
      "turns": [
        { "message": "정산 시트 만들어줘" },
        { "message": "정산 시트에 표 만들어줘" },
        { "message": "3행 3열, 머리글은 이름, 점수, 등급" }
      ],
      "oracle": {
        "result": {
          "assertions": [
            { "type": "sheet_exists", "sheet": "정산" },
            { "type": "header_equals", "sheet": "정산", "cell": "A1", "expected": "이름" },
            { "type": "header_equals", "sheet": "정산", "cell": "B1", "expected": "점수" },
            { "type": "header_equals", "sheet": "정산", "cell": "C1", "expected": "등급" },
            { "type": "cell_equals", "sheet": "평가", "cell": "A2", "expected": "민수" },
            { "type": "cell_equals", "sheet": "평가", "cell": "A3", "expected": "지은" },
            { "type": "cell_equals", "sheet": "평가", "cell": "C1", "expected": "결과" }
          ]
        }
      }
    }
  ]
}
